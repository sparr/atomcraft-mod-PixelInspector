<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PixelInspector</AssemblyName>
    <RootNamespace>PixelInspector</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <!-- Read by ModZip.targets for the staging folder, the zip name, and the install name.
         It must match mod.json's "id": the loader requires every file of a mod to sit inside
         a top-level folder named exactly the mod id. -->
    <ModId>PixelInspector</ModId>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test mod asserts on the two canvases and on the diagnostic's registration, neither of
         which is part of what another mod should be reaching for. Internals rather than a wider
         public surface: the API stays the thing a consumer sees. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PixelInspector.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Never copy game assemblies next to the mod DLL: the game already has them loaded, and
         a second copy in the mod's zip is at best dead weight and at worst a different
         version that wins nothing and confuses everything. -->
    <Reference Include="Atomcraft">
      <HintPath>$(GameDataDir)/Atomcraft.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The drawing library. Referenced, never shipped: the loader loads it from its own zip,
         and a second copy here would be a different assembly with the same types. Extracted out
         of the pinned zip by the scripts, so what this compiles against and what the game loads
         are the same bytes. -->
    <Reference Include="PixelArt">
      <HintPath>$(PixelArtDir)/PixelArt.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony is bundled by the mod loader; never ship 0Harmony.dll. Match the loader's
         version (2.4.2) rather than picking a newer one. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- minimal/ holds a single-file restatement of this mod and stays outside the SDK's
       **/*.cs glob by living beside src/, not inside it. Nothing to exclude here; the note
       exists so nobody moves it in. -->

  <Target Name="RequirePixelArtDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(PixelArtDir)' == '' OR !Exists('$(PixelArtDir)/PixelArt.dll')"
           Text="No PixelArt.dll under PixelArtDir='$(PixelArtDir)'. Run ./build.sh or ./run-tests.sh here, which extract the assembly out of the pinned PixelArt.zip, or pass -p:PixelArtDir=&lt;a folder holding PixelArt.dll&gt;. See pixelart.conf.example." />
  </Target>

  <Import Project="../ModZip.targets" />

</Project>
